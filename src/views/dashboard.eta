<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="color-scheme" content="dark">
  <title>Menthor Studio · Acompañamiento pedagógico</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/styles/tokens.css">
<link rel="stylesheet" href="/styles/base.css">
<link rel="stylesheet" href="/styles/layout.css">
<link rel="stylesheet" href="/styles/components.css">
</head>
<body>

  <a class="skip-link" href="#main-content">Saltar al contenido principal</a>

  <!-- ============================ BARRA SUPERIOR ============================ -->
  <header class="topbar">
    <div class="brand-group">
      <span class="brand-logo-mark" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
          <path d="M6 12v5c3 3 9 3 12 0v-5"/>
        </svg>
      </span>
      <span class="brand-title-wrap">
        <span class="brand-title">Menthor Studio <span class="brand-version">v0.1</span></span>
        <span class="brand-subtitle">Acompañamiento pedagógico · OpenCode</span>
      </span>
    </div>

    <div class="topbar-actions">
      <!-- Proyecto activo -->
      <div class="project-control" title="Directorio activo del proyecto">
        <span class="project-pill-icon" aria-hidden="true">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
          </svg>
        </span>
        <span class="project-pill-meta">
          <span class="project-pill-label">Proyecto activo</span>
          <span class="project-pill-path" id="projectPillPath"><span id="projectPillPathText">Cargando proyecto…</span></span>
        </span>
        <button type="button" class="btn-project-change" id="btnChangeProject" title="Cambiar carpeta de proyecto">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
          </svg>
          Cambiar
        </button>
      </div>

      <!-- Estado de sincronización -->
      <span class="live-badge" role="status" aria-live="polite">
        <span class="live-pulse" aria-hidden="true"></span>
        <span id="connectionText">Sincronizado</span>
      </span>

      <button type="button" class="btn-action" id="btnRefresh" title="Volver a leer LEARNING.md">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
          <path d="M3 3v5h5"/>
          <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/>
          <path d="M16 21h5v-5"/>
        </svg>
        <span class="btn-label">Refrescar</span>
      </button>

      <button type="button" class="btn-action" id="btnRawMd" title="Ver el archivo LEARNING.md sin procesar">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
          <polyline points="14 2 14 8 20 8"/>
          <line x1="16" y1="13" x2="8" y2="13"/>
          <line x1="16" y1="17" x2="8" y2="17"/>
        </svg>
        <span class="btn-label">LEARNING.md</span>
      </button>
    </div>
  </header>

  <!-- ============================ SUBHEADER FLOTANTE / STICKY NAV ============================ -->
  <nav class="sticky-task-nav" id="stickyTaskNav" aria-label="Navegación rápida de tarea" aria-hidden="true">
    <div class="sticky-task-nav-inner">
      <div class="sticky-task-info">
        <span class="sticky-task-dot" aria-hidden="true"></span>
        <span class="sticky-task-title" id="stickyTaskTitle">Tarea activa</span>
        <span class="sticky-progress-pill" id="stickyCriteriaProgress" title="Progreso de criterios cumplidos">0/0</span>
      </div>
      <div class="sticky-task-anchors">
        <a href="#tab-criteria" class="nav-anchor-btn" data-anchor="tab-criteria">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <span>Criterios</span>
        </a>
        <a href="#tab-hints" class="nav-anchor-btn" data-anchor="tab-hints">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/>
            <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/>
            <line x1="12" y1="17" x2="12.01" y2="17"/>
          </svg>
          <span>Pistas</span>
        </a>
        <a href="#tab-reference" class="nav-anchor-btn" data-anchor="tab-reference">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="16 18 22 12 16 6"/>
            <polyline points="8 6 2 12 8 18"/>
          </svg>
          <span>Referencia</span>
        </a>
      </div>
    </div>
  </nav>

  <!-- ============================ CONTENIDO PRINCIPAL ============================ -->
  <main class="studio-container" id="main-content">

    <!-- ---------------------- TAREA ACTIVA (foco principal) ---------------------- -->
    <section class="task-column" aria-label="Tarea activa">

      <!-- Bienvenida: falta LEARNING.md -->
      <div class="welcome-banner" id="welcomeBanner" style="display: none;">
        <div class="welcome-banner-header">
          <span class="welcome-banner-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
              <line x1="12" y1="11" x2="12" y2="17"/>
              <line x1="9" y1="14" x2="15" y2="14"/>
            </svg>
          </span>
          <div>
            <h2 class="welcome-banner-title">Conecta tu proyecto</h2>
            <p class="welcome-banner-desc">
              No encontramos <code class="inline-code">LEARNING.md</code> en el directorio activo. Indica la carpeta de tu
              proyecto (o ábrelo desde OpenCode) para empezar el acompañamiento guiado.
            </p>
          </div>
        </div>
        <div class="welcome-input-group">
          <label class="sr-only" for="welcomeProjectInput">Ruta absoluta de la carpeta del proyecto</label>
          <input type="text" class="text-input" id="welcomeProjectInput" placeholder="C:\\Ruta\\A\\Tu\\Proyecto" spellcheck="false" autocomplete="off">
          <button type="button" class="btn-primary" id="btnWelcomeLoad">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="9 18 15 12 9 6"/>
            </svg>
            Cargar proyecto
          </button>
        </div>
        <div class="quick-folder-chips">
          <span class="quick-folder-label">Sugerencia rápida</span>
          <button type="button" class="quick-folder-btn" id="chipPruebaAgente" data-path="C:\\Users\\Juan\\Desktop\\pruebaAgente">pruebaAgente (Escritorio)</button>
        </div>
      </div>

      <!-- Tarjeta de la tarea (Flujo continuo guiado de arriba a abajo) -->
      <article class="card active-task-hero" aria-labelledby="taskTitle">

        <div class="task-hero-top">
          <span class="task-badge-active" id="taskStatusBadge" data-state="active">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polygon points="5 3 19 12 5 21 5 3"/>
            </svg>
            <span id="taskStatusText">Tarea activa</span>
          </span>
        </div>

        <h1 class="task-title" id="taskTitle">Sin tarea asignada</h1>

        <div class="task-desc prose" id="taskDesc">Solicita una misión a Menthor para empezar a avanzar en tus competencias.</div>

        <!-- Foco inmediato: qué hacer ahora -->
        <div class="next-step" id="nextStepPanel" data-state="idle"></div>

        <div class="tabs-nav sr-tabs-nav" role="tablist" aria-label="Detalle de la tarea activa">
          <button type="button" class="tab-btn active" id="tabBtnCriteria" data-tab="tab-criteria" role="tab" aria-selected="true" aria-controls="tab-criteria" tabindex="0">
            Criterios de aceptación
            <span class="tab-count" id="criteriaTabCount">0</span>
          </button>
          <button type="button" class="tab-btn" id="tabBtnReference" data-tab="tab-reference" role="tab" aria-selected="false" aria-controls="tab-reference" tabindex="-1">
            Referencia y sintaxis
          </button>
          <button type="button" class="tab-btn" id="tabBtnHints" data-tab="tab-hints" role="tab" aria-selected="false" aria-controls="tab-hints" tabindex="-1">
            Pistas escalonadas
            <span class="tab-count" id="hintsTabCount">0</span>
          </button>
        </div>

        <!-- Flujo guiado secuencial: 1. Criterios de aceptación -->
        <section class="task-flow-section tab-panel active" id="tab-criteria" role="tabpanel" aria-labelledby="tabBtnCriteria" tabindex="0">
          <div class="flow-section-header">
            <div class="flow-header-left">
              <span class="flow-step-number" aria-hidden="true">1</span>
              <div>
                <h2 class="flow-section-title" id="criteriaSectionTitle">Criterios de aceptación</h2>
                <p class="panel-hint">Marca cada criterio a medida que lo completes. Menthor validará el resultado.</p>
              </div>
            </div>
            <span class="panel-count" id="criteriaProgressLabel">0 de 0 cumplidos</span>
          </div>
          <div class="criteria-checklist" id="criteriaChecklist" role="group" aria-label="Criterios de aceptación de la tarea"></div>
        </section>

        <!-- Flujo guiado secuencial: 2. Pistas escalonadas progresivas -->
        <section class="task-flow-section tab-panel active" id="tab-hints" role="tabpanel" aria-labelledby="tabBtnHints" tabindex="0">
          <div class="flow-section-header">
            <div class="flow-header-left">
              <span class="flow-step-number" aria-hidden="true">2</span>
              <div>
                <h2 class="flow-section-title" id="hintsSectionTitle">Pistas escalonadas</h2>
                <p class="panel-hint">Despliega de menor a mayor ayuda sólo si te bloqueas. Primero intenta resolverlo tú.</p>
              </div>
            </div>
          </div>
          <div class="hints-stack" id="hintsContainer"></div>
        </section>

        <!-- Flujo guiado secuencial: 3. Patrón de referencia y sintaxis -->
        <section class="task-flow-section tab-panel active" id="tab-reference" role="tabpanel" aria-labelledby="tabBtnReference" tabindex="0">
          <div class="flow-section-header">
            <div class="flow-header-left">
              <span class="flow-step-number" aria-hidden="true">3</span>
              <div>
                <h2 class="flow-section-title" id="referenceSectionTitle">Patrón de referencia y sintaxis</h2>
                <p class="panel-hint">Estructura sintáctica recomendada y notas de anatomía explicadas paso a paso.</p>
              </div>
            </div>
          </div>

            <div class="code-viewer-card">
              <div class="code-viewer-header">
                <div class="code-header-meta">
                  <span class="code-editor-dots" aria-hidden="true">
                    <span class="code-dot dot-red"></span>
                    <span class="code-dot dot-yellow"></span>
                    <span class="code-dot dot-green"></span>
                  </span>
                  <span class="code-lang-tag">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polyline points="16 18 22 12 16 6"/>
                      <polyline points="8 6 2 12 8 18"/>
                    </svg>
                    Patrón de referencia
                  </span>
                </div>
                <button type="button" class="btn-action btn-copy-snippet" id="btnCopySnippet" title="Copiar código al portapapeles">
                  <svg class="copy-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                  </svg>
                  <svg class="check-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:none;">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                  <span class="btn-label">Copiar</span>
                </button>
              </div>
              <pre class="code-pre" id="codeSnippetBox"><code>// Cargando patrón de referencia…</code></pre>
            </div>

          <div class="anatomy-notes">
            <span class="anatomy-title">Anatomía y buenas prácticas</span>
            <div class="anatomy-list" id="anatomyList"></div>
          </div>
        </section>

      </article>
    </section>

    <!-- ---------------------- RADAR PEDAGÓGICO (oculto / sin ruido visual) ---------------------- -->
    <!-- Contenedor oculto accesible/DOM: mantiene los nodos e IDs requeridos por la reactividad sin ocupar espacio ni flujo visual -->
    <aside class="radar-column" aria-label="Radar pedagógico" hidden style="display: none;">

      <section class="card radar-card project-hero-card" aria-labelledby="radarTitle">
        <div class="radar-header">
          <div class="radar-title-wrap">
            <span class="card-icon-badge" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <circle cx="12" cy="12" r="6"/>
                <circle cx="12" cy="12" r="2"/>
              </svg>
            </span>
            <h2 class="radar-title" id="radarTitle">Radar</h2>
          </div>
          <span class="status-pill" id="projectStatus">En curso</span>
        </div>

        <div class="radar-section">
          <span class="block-eyebrow">Objetivo</span>
          <div class="objective-content" id="projectObjective">Cargando objetivo…</div>
        </div>

        <div class="radar-section">
          <span class="block-eyebrow">Stack</span>
          <div class="meta-row" id="techStackContainer"></div>
        </div>

        <div class="status-block" id="projectStatusBlock" hidden>
          <span class="block-eyebrow">Estado del proyecto</span>
          <div class="status-text prose" id="projectStatusDetail"></div>
        </div>

        <!-- Progreso compacto: barra limpia sin números porcentuales redundantes -->
        <div class="progress-section compact-progress">
          <div class="progress-labels">
            <span class="progress-title">Competencias</span>
            <!-- Se conservan los IDs para reactividad de datos -->
            <span class="progress-pct sr-only" id="competencyPct">0%</span>
            <p class="progress-hint" id="progressHint">0 de 0 dominadas</p>
          </div>
          <div class="progress-track" id="competencyTrack" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-label="Competencias dominadas">
            <span class="progress-fill" id="progressFill"></span>
          </div>
        </div>
      </section>

      <section class="card radar-card" aria-labelledby="competenciesTitle">
        <div class="radar-section-header">
          <div class="radar-title-wrap">
            <span class="card-icon-badge is-emerald" aria-hidden="true">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                <polyline points="22 4 12 14.01 9 11.01"/>
              </svg>
            </span>
            <h3 class="radar-subheading" id="competenciesTitle">Competencias</h3>
          </div>
          <span class="count-chip sr-only" id="compCount">0/0</span>
        </div>
        <ul class="status-summary sr-only" id="compSummary" hidden></ul>
        <ul class="items-list compact-list" id="competenciesList"></ul>
      </section>

      <section class="card radar-card" aria-labelledby="conceptsTitle">
        <div class="radar-section-header">
          <div class="radar-title-wrap">
            <span class="card-icon-badge is-purple" aria-hidden="true">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 1 1 7.072 0l-.548.547A3.374 3.374 0 0 0 14 18.469V19a2 2 0 1 1-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
              </svg>
            </span>
            <h3 class="radar-subheading" id="conceptsTitle">Conceptos clave</h3>
          </div>
          <span class="count-chip sr-only" id="conceptsCount">0/0</span>
        </div>
        <ul class="items-list compact-list" id="conceptsList"></ul>
      </section>

    </aside>
  </main>

  <!-- ============================ MODAL: LEARNING.MD ============================ -->
  <div class="modal-backdrop" id="rawModalBackdrop" role="dialog" aria-modal="true" aria-labelledby="rawModalTitle">
    <div class="modal-window">
      <div class="modal-header">
        <div>
          <h3 class="modal-title" id="rawModalTitle">LEARNING.md sin procesar</h3>
          <p class="modal-subtitle">Contenido textual del archivo de seguimiento del proyecto activo.</p>
        </div>
        <button type="button" class="btn-action" id="btnCloseModal" aria-label="Cerrar ventana">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
          Cerrar
        </button>
      </div>
      <div class="modal-body">
        <pre id="rawMarkdownContent">Cargando…</pre>
      </div>
    </div>
  </div>

  <!-- ============================ MODAL: CAMBIAR PROYECTO ============================ -->
  <div class="modal-backdrop" id="projectDirModal" role="dialog" aria-modal="true" aria-labelledby="projectModalTitle">
    <div class="modal-window" style="max-width: 36rem;">
      <div class="modal-header">
        <div>
          <h3 class="modal-title" id="projectModalTitle">Cambiar directorio de proyecto</h3>
          <p class="modal-subtitle">Menthor leerá el archivo LEARNING.md de esa carpeta.</p>
        </div>
        <button type="button" class="btn-action" id="btnCloseProjectModal" aria-label="Cerrar ventana">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
          Cerrar
        </button>
      </div>
      <div class="modal-body is-plain">
        <label class="modal-note" for="projectModalInput">Ruta absoluta de la carpeta que contiene (o contendrá) <code class="inline-code">LEARNING.md</code>.</label>
        <input type="text" class="text-input" id="projectModalInput" placeholder="C:\\Users\\nombre\\mi-proyecto" spellcheck="false" autocomplete="off" style="width: 100%; margin-bottom: var(--space-4);">
        <div class="modal-actions">
          <button type="button" class="btn-ghost" id="btnCancelProjectModal">Cancelar</button>
          <button type="button" class="btn-primary" id="btnConfirmProjectModal">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            Cargar proyecto
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- ============================ AVISO FLOTANTE ============================ -->
  <div class="toast" id="toastBox" role="status" aria-live="polite">
    <svg class="toast-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="20 6 9 17 4 12"/>
    </svg>
    <span id="toastMessage">Acción completada</span>
  </div>

<script id="initial-state" type="application/json"><%~ it.stateJson %></script>
<script type="module" src="/js/main.js"></script>
</body>
</html>
